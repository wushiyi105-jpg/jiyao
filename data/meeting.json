{
  "templates": [
    {
      "name": "周会",
      "sections": ["本周进展", "决议", "待办", "悬置问题", "风险与依赖"],
      "email_subject": "【周会纪要】{topic} {date}",
      "email_intro": "本周会已开完，纪要如下，请各位核对各自待办。"
    },
    {
      "name": "评审",
      "sections": ["评审对象", "结论", "遗留问题", "待办", "下次评审"],
      "email_subject": "【评审结论】{topic} {date}",
      "email_intro": "评审结论与遗留问题如下，未通过项请按待办整改后复评。"
    },
    {
      "name": "复盘",
      "sections": ["目标与结果", "做对了什么", "哪里出了问题", "决议", "待办"],
      "email_subject": "【复盘纪要】{topic} {date}",
      "email_intro": "复盘结论如下，改进项已落到人，请按截止时间推进。"
    },
    {
      "name": "客户",
      "sections": ["客户诉求", "我方答复", "待办", "悬置问题", "下次沟通"],
      "email_subject": "【客户沟通纪要】{topic} {date}",
      "email_intro": "今日沟通要点如下，我方待办与需客户确认项已分别列出。"
    }
  ],
  "verbs": ["输出", "提交", "确认", "对接", "修复", "上线", "评审", "整理", "发", "写",
            "改", "跟进", "落实", "排期", "拉齐", "同步", "补充", "验证", "回滚", "交付", "看", "处理", "评估"],
  "vague": ["尽快", "回头", "看看", "之后", "有时间", "下周找时间", "晚点", "抽空", "再说"],
  "decision_markers": ["定了", "就这么定", "拍板", "通过", "同意", "按这个来", "敲定", "确认采用"],
  "suspend_markers": ["下次再说", "待定", "未定", "没有结论", "再看看", "回头讨论", "先放着", "暂缓"],
  "dependency_markers": ["等", "依赖", "拿到", "前提是"],
  "deadline_words": {
    "今天": 0, "明天": 1, "后天": 2, "大后天": 3
  },
  "notes": "决议与悬置靠标记词召回，再由模型判断语气；日期、人名、数字由本地抽取，模型不得改写。"
}

